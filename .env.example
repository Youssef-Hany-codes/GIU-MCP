# Optional. The normal way to sign in is `giu-mcp login`, which keeps your password in the
# OS credential store. Use a .env only for development, or if you prefer it: put it in the
# config folder that `giu-mcp status` prints (or the project folder when running from source).

# Exactly what you type in the browser's sign-in box for portal.giu-uni.de / cms.giu-uni.de
GIU_USERNAME=
# Wrap in single quotes if it contains #, spaces or quotes, e.g. 'my#pass word'
GIU_PASSWORD=

# Optional: Windows domain, only if sign-in fails without it (then the username is sent as DOMAIN\username)
GIU_DOMAIN=

# Optional: where CMS course files are downloaded (default: ~/Downloads/GIU)
GIU_DOWNLOAD_DIR=
